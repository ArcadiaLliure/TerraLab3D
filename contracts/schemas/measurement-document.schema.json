{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terralab3d.local/schemas/measurement-document.schema.json",
  "title": "TerraLab3D measurement document snapshot v1",
  "type": "object",
  "required": ["type", "schemaVersion", "measurementRevision", "trackingEnabled", "measurements", "selectedMeasurementId", "canUndo", "canRedo", "warning"],
  "properties": {
    "type": { "const": "measurement_snapshot" },
    "schemaVersion": { "const": 1 },
    "measurementRevision": { "type": "integer", "minimum": 0 },
    "trackingEnabled": { "type": "boolean" },
    "measurements": { "type": "array", "items": { "$ref": "#/$defs/measurement" } },
    "selectedMeasurementId": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] },
    "canUndo": { "type": "boolean" },
    "canRedo": { "type": "boolean" },
    "warning": { "type": ["string", "null"] }
  },
  "additionalProperties": false,
  "$defs": {
    "coordinate": {
      "type": "object",
      "required": ["altitudeDeg", "azimuthDeg"],
      "properties": {
        "altitudeDeg": { "type": "number", "minimum": -90, "maximum": 90 },
        "azimuthDeg": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 }
      },
      "additionalProperties": false
    },
    "geometry": {
      "type": "object",
      "required": ["paths", "label", "anchor"],
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/coordinate" } }
        },
        "label": { "type": "string", "minLength": 1 },
        "anchor": { "$ref": "#/$defs/coordinate" }
      },
      "additionalProperties": false
    },
    "measurement": {
      "type": "object",
      "required": ["measurementId", "kind", "start", "end", "rotationDeg", "tracking", "fixedQuaternion", "entityVersion", "geometry"],
      "properties": {
        "measurementId": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["ruler", "square", "rectangle", "circle"] },
        "start": { "$ref": "#/$defs/coordinate" },
        "end": { "$ref": "#/$defs/coordinate" },
        "rotationDeg": { "type": "number" },
        "tracking": { "type": "boolean" },
        "fixedQuaternion": {
          "oneOf": [
            { "type": "null" },
            { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }, { "type": "number" }], "minItems": 4, "maxItems": 4 }
          ]
        },
        "entityVersion": { "type": "integer", "minimum": 1 },
        "geometry": { "$ref": "#/$defs/geometry" }
      },
      "additionalProperties": false
    }
  }
}

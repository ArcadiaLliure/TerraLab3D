+    this.layerHeight = tile.height;
+    this.gridColumns = columns;
+    this.gridRows = rows;
+    this.tileWorldSize.set(tileWorldX, tileWorldY);
+    this.activeBounds.set(gridMinX, gridMinY, gridMaxX, gridMaxY);

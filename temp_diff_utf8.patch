+    this.activeCoverageTexture = null;
+    this.classData = null;
+    this.layerWidth = 0;
+    this.layerHeight = 0;
+    this.gridColumns = 0;
+    this.gridRows = 0;
+    this.activeBounds.set(0, 0, 0, 0);
+    this.tileWorldSize.set(1, 1);
+    if (clearPending) this.pendingTiles = [];
+  }
